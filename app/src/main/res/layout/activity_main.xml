<?xml version="1.0" encoding="utf-8"?>
<!-- TV setup screen. Plain, shallow View hierarchy with flat shapes (no shadows, borders, blur or
     animations beyond the button focus scale), so it draws cheaply on 1GB Android TV boxes. The window
     background paints the screen once; nothing here repaints it. Sized to fit a 960x540dp TV screen
     without scrolling; the ScrollView only matters on smaller displays or larger font sizes. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- Padding lives on the content, not the ScrollView: a padded ScrollView stops scrolling
         with the last focused button mostly out of view on a TV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingTop="20dp"
        android:paddingRight="48dp"
        android:paddingBottom="20dp">

        <!-- Header: name, setup progress, and what to do next -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AlterSub"
                android:textColor="@color/accent"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReadyChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_chip"
                android:paddingLeft="12dp"
                android:paddingTop="4dp"
                android:paddingRight="12dp"
                android:paddingBottom="4dp"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="2 steps left" />

            <TextView
                android:id="@+id/tvNextStep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:gravity="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Almost there. Finish the required steps so AlterSub works on its own." />
        </LinearLayout>

        <!-- Two columns of equal height: the remote card stretches to end where the last setup card ends,
             and each column starts with a label row of the same height so the first cards line up too -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:orientation="horizontal">

            <!-- Left: required setup, then optional extras -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.45"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.AlterSub.ColumnLabel"
                    android:text="Required" />

                <!-- 1. Overlay permission; once allowed, its button becomes the test -->
                <LinearLayout style="@style/Widget.AlterSub.SetupRow">

                    <ImageView
                        android:id="@+id/ivOverlayStatus"
                        style="@style/Widget.AlterSub.StatusIcon"
                        android:src="@drawable/ic_status_todo" />

                    <LinearLayout style="@style/Widget.AlterSub.RowText">

                        <TextView
                            android:id="@+id/tvOverlayStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Show subtitles over other apps"
                            android:textAppearance="@style/TextAppearance.AlterSub.RowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lets AlterSub draw text over the video."
                            android:textAppearance="@style/TextAppearance.AlterSub.RowBody" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnOverlayPermission"
                        style="@style/Widget.AlterSub.TvButton.Action"
                        android:text="Allow" />

                    <Button
                        android:id="@+id/btnTestSubtitle"
                        style="@style/Widget.AlterSub.TvButton.Action"
                        android:text="Test subtitles"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 2. Accessibility (title detection) -->
                <LinearLayout style="@style/Widget.AlterSub.SetupRow">

                    <ImageView
                        android:id="@+id/ivAccessibilityStatus"
                        style="@style/Widget.AlterSub.StatusIcon"
                        android:src="@drawable/ic_status_todo" />

                    <LinearLayout style="@style/Widget.AlterSub.RowText">

                        <TextView
                            android:id="@+id/tvAccessibilityStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recognise what's playing"
                            android:textAppearance="@style/TextAppearance.AlterSub.RowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reads the title on screen to find subtitles."
                            android:textAppearance="@style/TextAppearance.AlterSub.RowBody" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnAccessibilityPermission"
                        style="@style/Widget.AlterSub.TvButton.Action"
                        android:text="Enable" />
                </LinearLayout>

                <!-- 3. Notification listener (MediaSession play/pause + position) -->
                <LinearLayout style="@style/Widget.AlterSub.SetupRow">

                    <ImageView
                        android:id="@+id/ivNotificationStatus"
                        style="@style/Widget.AlterSub.StatusIcon"
                        android:src="@drawable/ic_status_todo" />

                    <LinearLayout style="@style/Widget.AlterSub.RowText">

                        <TextView
                            android:id="@+id/tvNotificationStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Follow play and pause"
                            android:textAppearance="@style/TextAppearance.AlterSub.RowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Keeps subtitles in time as you pause or seek."
                            android:textAppearance="@style/TextAppearance.AlterSub.RowBody" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnNotificationPermission"
                        style="@style/Widget.AlterSub.TvButton.Action"
                        android:text="Enable" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.AlterSub.ColumnLabel"
                    android:layout_marginTop="16dp"
                    android:text="Optional" />

                <!-- Netflix spoken-title detection: text on top, its controls on one row underneath -->
                <LinearLayout
                    style="@style/Widget.AlterSub.SetupRow"
                    android:gravity="top">

                    <ImageView
                        android:id="@+id/ivNetflixSpeechStatus"
                        style="@style/Widget.AlterSub.StatusIcon"
                        android:src="@drawable/ic_status_off" />

                    <LinearLayout
                        style="@style/Widget.AlterSub.RowText"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Netflix titles"
                            android:textAppearance="@style/TextAppearance.AlterSub.RowTitle" />

                        <TextView
                            android:id="@+id/tvNetflixSpeechStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textAppearance="@style/TextAppearance.AlterSub.RowBody"
                            tools:text="Lets AlterSub recognise what you play on Netflix." />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Focus lights up the box only (checkbox_tv), not the label -->
                            <CheckBox
                                android:id="@+id/cbMuteNetflixSpeech"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/action_height"
                                android:background="@null"
                                android:button="@drawable/checkbox_tv"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/mute_netflix_announcements"
                                android:textColor="@color/text_main"
                                android:textSize="14sp" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <Button
                                android:id="@+id/btnNetflixHelp"
                                style="@style/Widget.AlterSub.HelpButton"
                                android:layout_marginEnd="12dp"
                                android:contentDescription="How Netflix titles work" />

                            <Button
                                android:id="@+id/btnNetflixSpeechSetup"
                                style="@style/Widget.AlterSub.TvButton.Action"
                                android:layout_marginStart="0dp"
                                android:text="Set up" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Right: phone remote. Shows either the pairing block (QR + steps) or a status row
                 (connected / off / couldn't start / locked), then the address, then the actions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="28dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/column_label_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Phone remote"
                        android:textAppearance="@style/TextAppearance.AlterSub.SectionLabel" />

                    <TextView
                        android:id="@+id/tvRemoteStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingLeft="10dp"
                        android:paddingTop="3dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="3dp"
                        android:textFontWeight="500"
                        android:textSize="12sp"
                        tools:text="Waiting for phone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/card_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingLeft="22dp"
                    android:paddingTop="22dp"
                    android:paddingRight="22dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:id="@+id/remotePairing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivRemoteQr"
                            android:layout_width="132dp"
                            android:layout_height="132dp"
                            android:background="@drawable/bg_qr"
                            android:contentDescription="QR code that opens and pairs the phone remote"
                            android:scaleType="fitCenter" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Scan to connect"
                                android:textColor="@color/text_main"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:lineSpacingExtra="6dp"
                                android:text="1.  Open your camera\n2.  Point it at the code\n3.  Tap the link"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/remoteStateRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivRemoteState"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_status_done" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRemoteStateTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_main"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="Phone connected" />

                            <TextView
                                android:id="@+id/tvRemoteStateBody"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                tools:text="Pick subtitles and fix the timing from the AlterSub page on your phone." />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/remoteAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="18dp"
                            android:background="@color/divider" />

                        <TextView
                            android:id="@+id/tvAddressLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            tools:text="Or type this address in your phone's browser" />

                        <TextView
                            android:id="@+id/tvIpAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/accent"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            tools:text="192.168.1.5:8080" />

                        <LinearLayout
                            android:id="@+id/remotePinRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="true"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="and enter PIN"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvRemotePin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:letterSpacing="0.06"
                                android:textColor="@color/text_main"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="482 913" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Pushes the buttons to the bottom of the card (whose bottom padding matches the setup cards'), level with Set up -->
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="12dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnUnpairPhones"
                            style="@style/Widget.AlterSub.TvButton.Action"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="12dp"
                            android:text="Unpair phone" />

                        <Button
                            android:id="@+id/btnWebRemoteToggle"
                            style="@style/Widget.AlterSub.TvButton.Action"
                            android:layout_marginStart="0dp"
                            android:text="Turn off" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
