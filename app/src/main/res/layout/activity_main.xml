<?xml version="1.0" encoding="utf-8"?>
<!-- TV setup screen. Plain, shallow View hierarchy with flat shapes (no shadows, borders, blur or
     animations beyond the button focus scale), so it draws cheaply on 1GB Android TV boxes. The window
     background paints the screen once; nothing here repaints it. Sized to fit a 960x540dp TV screen
     without scrolling; the ScrollView only matters on smaller displays. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- Padding lives on the content, not the ScrollView: a padded ScrollView stops scrolling
         with the last focused button mostly out of view on a TV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingTop="28dp"
        android:paddingRight="48dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AlterSub"
                android:textColor="@color/accent"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReadyChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_chip"
                android:paddingLeft="12dp"
                android:paddingTop="4dp"
                android:paddingRight="12dp"
                android:paddingBottom="4dp"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="2 steps left" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Your own subtitles, over any streaming app."
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:orientation="horizontal">

            <!-- Left: setup checklist and test -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Setup"
                    android:textAppearance="@style/TextAppearance.AlterSub.SectionLabel" />

                <!-- 1. Overlay permission -->
                <LinearLayout style="@style/Widget.AlterSub.SetupRow">

                    <ImageView
                        android:id="@+id/ivOverlayStatus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_status_todo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvOverlayStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Show subtitles over other apps"
                            android:textAppearance="@style/TextAppearance.AlterSub.RowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Required. Lets AlterSub draw text over the video."
                            android:textAppearance="@style/TextAppearance.AlterSub.RowBody" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnOverlayPermission"
                        style="@style/Widget.AlterSub.TvButton.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allow" />
                </LinearLayout>

                <!-- 2. Accessibility (title detection) -->
                <LinearLayout style="@style/Widget.AlterSub.SetupRow">

                    <ImageView
                        android:id="@+id/ivAccessibilityStatus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_status_todo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAccessibilityStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recognise what's playing"
                            android:textAppearance="@style/TextAppearance.AlterSub.RowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Finds subtitles by reading the title on screen."
                            android:textAppearance="@style/TextAppearance.AlterSub.RowBody" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnAccessibilityPermission"
                        style="@style/Widget.AlterSub.TvButton.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable" />
                </LinearLayout>

                <!-- 3. Notification listener (MediaSession play/pause + position) -->
                <LinearLayout style="@style/Widget.AlterSub.SetupRow">

                    <ImageView
                        android:id="@+id/ivNotificationStatus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_status_todo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNotificationStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Follow play and pause"
                            android:textAppearance="@style/TextAppearance.AlterSub.RowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Keeps subtitles in time when you pause, seek or skip."
                            android:textAppearance="@style/TextAppearance.AlterSub.RowBody" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnNotificationPermission"
                        style="@style/Widget.AlterSub.TvButton.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNextStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="You're all set. Start a show in your streaming app and subtitles appear automatically." />

                <!-- Padded row so the focused button can scale up without being clipped -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <Button
                        android:id="@+id/btnTestSubtitle"
                        style="@style/Widget.AlterSub.TvButton.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show test subtitles" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right: phone remote -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phone remote"
                    android:textAppearance="@style/TextAppearance.AlterSub.SectionLabel" />

                <ImageView
                    android:id="@+id/ivRemoteQr"
                    android:layout_width="156dp"
                    android:layout_height="156dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_qr"
                    android:contentDescription="QR code to open the phone remote"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tvRemoteHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Scan with your phone's camera"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvIpAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    tools:text="or open http://192.168.1.5:8080" />

                <TextView
                    android:id="@+id/tvRemotePin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="and enter PIN 482 913" />

                <TextView
                    android:id="@+id/tvPairedPhones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="1 phone paired" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingTop="4dp">

                    <Button
                        android:id="@+id/btnUnpairPhones"
                        style="@style/Widget.AlterSub.TvButton.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unpair all" />

                    <Button
                        android:id="@+id/btnWebRemoteToggle"
                        style="@style/Widget.AlterSub.TvButton.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Turn off" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
