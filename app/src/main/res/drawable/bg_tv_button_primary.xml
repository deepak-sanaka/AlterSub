<?xml version="1.0" encoding="utf-8"?>
<!-- The primary action is outlined in yellow while idle, so only the focused button is ever filled yellow
     and D-pad focus stays unambiguous -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_idle" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
