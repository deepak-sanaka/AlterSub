<?xml version="1.0" encoding="utf-8"?>
<!-- TV checkbox: D-pad focus highlights the box itself, not the whole row of text -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_checkbox_on_focused" android:state_checked="true" android:state_focused="true" />
    <item android:drawable="@drawable/ic_checkbox_off_focused" android:state_focused="true" />
    <item android:drawable="@drawable/ic_checkbox_on_focused" android:state_checked="true" android:state_pressed="true" />
    <item android:drawable="@drawable/ic_checkbox_off_focused" android:state_pressed="true" />
    <item android:drawable="@drawable/ic_checkbox_on" android:state_checked="true" />
    <item android:drawable="@drawable/ic_checkbox_off" />
</selector>
